{
  "name": "ProjectCost",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "equipment",
        "labour",
        "subcontractor",
        "logistics",
        "permits",
        "other"
      ],
      "default": "equipment"
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "cost_date": {
      "type": "string",
      "format": "date"
    },
    "vendor": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}